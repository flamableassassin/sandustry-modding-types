{
  "include": ["./src/*"],
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "lib": ["es6", "dom"],
    "exactOptionalPropertyTypes": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "types": ["react"],
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
  }
}
